# VITE_CHAT_API_BASE_URL=http://localhost:9012
# VITE_EXTERNAL_DASHBOARD_URL=https://dashboard.thentrepreneurlab.com/entrepreneur

# VITE_CHAT_API_BASE_URL=https://backend.thentrepreneurlab.com
# VITE_EXTERNAL_DASHBOARD_URL=https://dashboard.thentrepreneurlab.com/entrepreneur


DJANGO_SETTINGS_MODULE=backend.settings.dev
HOST=localhost
PORT=9018
DBUSER=
DBNAME=
DBPASSWORD=
TEST_DB_NAME=founders_lab_test
DBHOST="${HOST}"
DBPORT=5435
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
MODEL_PLATFORM=openai
BUBBLE_API_KEY=
BUBBLE_BASE_URL=
BUBBLE_PASSWORD_DEFAULT=1234567890
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
GOOGLE_API_KEY=
FRONTEND_URL=https://agent.thentrepreneurlab.com?sid={}
BACKEND_URL=https://backend.thentrepreneurlab.com

# PRODUCTION (backend.settings.prod). Every value below is required there; startup fails if one is missing.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# JWT_SIGNING_KEY must differ from SECRET_KEY. Lists are comma-separated; origins must be https://
SECRET_KEY=
JWT_SIGNING_KEY=
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

TOKEN_DISABLE_ACCOUNT=